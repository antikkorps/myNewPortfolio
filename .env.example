# Contact form (/contact), sent through Resend by app/lib/mailer.server.ts.
# Locally in .env, in production via the Vercel project settings.

# Resend API key, "Sending access" scope
RESEND_API_KEY=re_xxxxxxxx
# From address, on a domain verified in Resend
EMAIL_FROM="Name <contact@example.com>"
# Where incoming messages are delivered
EMAIL_RECIPIENT=you@example.com
# Optional blind copy
EMAIL_BCC=
